{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/academics",
      "destination": "/#credentials",
      "permanent": true
    },
    {
      "source": "/achievements",
      "destination": "/#credentials",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "/#research",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/feedbacks",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
